# The Writer's Corner — example environment configuration.
# Copy this file to `.env` and fill in real values.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@host:5432/dbname?connect_timeout=15"

# Secret used by NextAuth to sign/encrypt sessions.
NEXTAUTH_SECRET="change-me"

# ---------------------------------------------------------------------------
# DEMO_FAILURE_MODE (demo/staging only)
# ---------------------------------------------------------------------------
# Reversible, read-only demonstration mode. When true:
#   - the community timeline/feed returns frozen fixture data (no DB query),
#   - post/submission writes return HTTP 503 { "error": "demo_write_disabled" },
#   - a yellow "Demo Mode" banner is shown across the app.
# Rollback: set to false (or remove this line) and restart the app to fully
# restore live behavior. No data is mutated and no migrations are run.
DEMO_FAILURE_MODE=false # Set to true to enable demo mode (disables writes, freezes timeline data)
