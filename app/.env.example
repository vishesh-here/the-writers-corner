# The Writer's Corner — example environment configuration.
# Copy this file to `.env` and fill in real values.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@host:5432/dbname?connect_timeout=15"

# Secret used by NextAuth to sign/encrypt sessions.
NEXTAUTH_SECRET="change-me"

# Serve the community feed from a static snapshot instead of the database.
FEED_CACHE_STATIC=false
